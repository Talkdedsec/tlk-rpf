{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tlk-rpf",
  "version": "1.2.0",
  "identifier": "com.talkdedsec.tlkrpf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tlk-rpf",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": true,
        "backgroundColor": "#0e0e10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://tlk.localhost tlk:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://tlk.localhost tlk: https://api.anthropic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Talkdedsec",
    "copyright": "Copyright (c) 2026 Talkdedsec. Licensed under GPL-3.0-only.",
    "category": "Utility",
    "shortDescription": "FiveM mods klasörü rpf düzenleyici",
    "longDescription": "FiveM mods klasöründeki .rpf paketlerini açar; doku, görsel ayar, parçacık efekti, model, harita ve arayüz dosyalarını yedekli ve geri alınabilir şekilde düzenler.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
